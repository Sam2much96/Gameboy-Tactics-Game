# Editor autosave/backup files (Krita, and anything else using the same
# trailing-~ convention — found one even inside godot-tactics/)
*~

# Reference-image rips from other commercial games — copyright exposure,
# never publish these alongside original project code.
/coverart refs
/tiles_ref

# Godot Web export output — regenerated from the Godot project on each
# export, and the .wasm/.pck payloads are large binary build artifacts, not
# source.
/game_boy_web_godot

