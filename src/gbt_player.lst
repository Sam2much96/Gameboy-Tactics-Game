    0000003C                        178 _gbt_play::
                                    179 
    0000003C C5               [16]  180 	push	bc
                                    181 
                                    182 	; GBDK-2020 calling convention: DE=data, A=bank, stack[sp+4]=speed
    0000003D 4F               [ 4]  183 	ld	c,a		; save bank in c (frees A for other use)
    0000003E F8 04            [12]  184 	lda	hl,4(sp)
    00000040 46               [ 8]  185 	ld	b,(hl)		; b = speed  (past push-bc=2 and return-addr=2)
                                    186 
                                    187 	; de = data
                                    188 	; b = speed , c = bank
                                    189 
    00000041 21 01 00         [12]  190 	ld	hl,#gbt_song
    00000044 72               [ 8]  191 	ld	(hl),d
    00000045 23               [ 8]  192 	inc	hl
    00000046 73               [ 8]  193 	ld	(hl),e
                                    194 
    00000047 79               [ 4]  195 	ld	a,c
    00000048 EA 03 00         [16]  196 	ld	(gbt_bank),a
    0000004B 78               [ 4]  197 	ld	a,b
    0000004C EA 04 00         [16]  198 	ld	(gbt_speed),a
                                    199 
    0000004F 3E 00            [ 8]  200 	ld	a,#0
    00000051 CD 00 00         [24]  201 	call	gbt_get_pattern_ptr
                                    202 
    00000054 AF               [ 4]  203 	xor	a,a
    00000055 EA 13 00         [16]  204 	ld	(gbt_current_step),a
    00000058 EA 14 00         [16]  205 	ld	(gbt_current_pattern),a
    0000005B EA 12 00         [16]  206 	ld	(gbt_ticks_elapsed),a
    0000005E EA 11 00         [16]  207 	ld	(gbt_loop_enabled),a
    00000061 EA 3E 00         [16]  208 	ld	(gbt_have_to_stop_next_step),a
    00000064 EA 3F 00         [16]  209 	ld	(gbt_update_pattern_pointers),a
                                    210 
    00000067 3E FF            [ 8]  211 	ld	a,#0xFF
    00000069 EA 2A 00         [16]  212 	ld	(gbt_channel3_loaded_instrument),a
                                    213 
    0000006C 3E 0F            [ 8]  214 	ld	a,#0x0F
    0000006E EA 17 00         [16]  215 	ld	(gbt_channels_enabled),a
                                    216 
    00000071 21 18 00         [12]  217 	ld	hl,#gbt_pan
    00000074 3E 11            [ 8]  218 	ld	a,#0x11 ; L and R
    00000076 22               [ 8]  219 	ld	(hl+),a
    00000077 CB 27            [ 8]  220 	sla	a
    00000079 22               [ 8]  221 	ld	(hl+),a
    0000007A CB 27            [ 8]  222 	sla	a
    0000007C 22               [ 8]  223 	ld	(hl+),a
    0000007D CB 27            [ 8]  224 	sla	a
    0000007F 77               [ 8]  225 	ld	(hl),a
                                    226 
    00000080 21 1C 00         [12]  227 	ld	hl,#gbt_vol
    00000083 3E F0            [ 8]  228 	ld	a,#0xF0 ; 100%
    00000085 22               [ 8]  229 	ld	(hl+),a
    00000086 22               [ 8]  230 	ld	(hl+),a
    00000087 3E 20            [ 8]  231 	ld	a,#0x20 ; 100%
    00000089 22               [ 8]  232 	ld	(hl+),a
    0000008A 3E F0            [ 8]  233 	ld	a,#0xF0 ; 100%
    0000008C 22               [ 8]  234 	ld	(hl+),a
                                    235 
    0000008D 3E 00            [ 8]  236 	ld	a,#0
                                    237 
    0000008F 21 20 00         [12]  238 	ld	hl,#gbt_instr
    00000092 22               [ 8]  239 	ld	(hl+),a
    00000093 22               [ 8]  240 	ld	(hl+),a
    00000094 22               [ 8]  241 	ld	(hl+),a
    00000095 22               [ 8]  242 	ld	(hl+),a
                                    243 
    00000096 21 24 00         [12]  244 	ld	hl,#gbt_freq
    00000099 22               [ 8]  245 	ld	(hl+),a
    0000009A 22               [ 8]  246 	ld	(hl+),a
    0000009B 22               [ 8]  247 	ld	(hl+),a
    0000009C 22               [ 8]  248 	ld	(hl+),a
    0000009D 22               [ 8]  249 	ld	(hl+),a
    0000009E 22               [ 8]  250 	ld	(hl+),a
                                    251 
    0000009F EA 34 00         [16]  252 	ld	(gbt_arpeggio_enabled+0),a
    000000A2 EA 35 00         [16]  253 	ld	(gbt_arpeggio_enabled+1),a
    000000A5 EA 36 00         [16]  254 	ld	(gbt_arpeggio_enabled+2),a
                                    255 
    000000A8 3E FF            [ 8]  256 	ld	a,#0xFF
    000000AA EA 3A 00         [16]  257 	ld	(gbt_cut_note_tick+0),a
    000000AD EA 3B 00         [16]  258 	ld	(gbt_cut_note_tick+1),a
    000000B0 EA 3C 00         [16]  259 	ld	(gbt_cut_note_tick+2),a
    000000B3 EA 3D 00         [16]  260 	ld	(gbt_cut_note_tick+3),a
                                    261 
    000000B6 3E 80            [ 8]  262 	ld	a,#0x80
    000000B8 E0 26            [12]  263 	ldh	(#.NR52),a
    000000BA 3E 00            [ 8]  264 	ld	a,#0x00
    000000BC E0 25            [12]  265 	ldh	(#.NR51),a
    000000BE 3E 00            [ 8]  266 	ld	a,#0x00 ; 0%
    000000C0 E0 24            [12]  267 	ldh	(#.NR50),a
                                    268 
    000000C2 AF               [ 4]  269 	xor	a,a
    000000C3 E0 10            [12]  270 	ldh	(#.NR10),a
    000000C5 E0 11            [12]  271 	ldh	(#.NR11),a
    000000C7 E0 12            [12]  272 	ldh	(#.NR12),a
    000000C9 E0 13            [12]  273 	ldh	(#.NR13),a
    000000CB E0 14            [12]  274 	ldh	(#.NR14),a
    000000CD E0 16            [12]  275 	ldh	(#.NR21),a
