    000000D3 E0 19            [12]  278 	ldh	(#.NR24),a
    000000D5 E0 1A            [12]  279 	ldh	(#.NR30),a
    000000D7 E0 1B            [12]  280 	ldh	(#.NR31),a
    000000D9 E0 1C            [12]  281 	ldh	(#.NR32),a
    000000DB E0 1D            [12]  282 	ldh	(#.NR33),a
    000000DD E0 1E            [12]  283 	ldh	(#.NR34),a
    000000DF E0 20            [12]  284 	ldh	(#.NR41),a
    000000E1 E0 21            [12]  285 	ldh	(#.NR42),a
    000000E3 E0 22            [12]  286 	ldh	(#.NR43),a
    000000E5 E0 23            [12]  287 	ldh	(#.NR44),a
                                    288 
    000000E7 3E 77            [ 8]  289 	ld	a,#0x77 ; 100%
    000000E9 E0 24            [12]  290 	ldh	(#.NR50),a
