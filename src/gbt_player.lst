    0000010D                        335 _gbt_stop::
    0000010D AF               [ 4]  336 	xor	a
    0000010E EA 00 00         [16]  337 	ld	(gbt_playing),a
    00000111 E0 24            [12]  338 	ldh	(#.NR50),a
    00000113 E0 25            [12]  339 	ldh	(#.NR51),a
    00000115 E0 26            [12]  340 	ldh	(#.NR52),a
    00000117 C9               [16]  341 	ret
