    0000011F                        353 _gbt_update::
                                    354 
    0000011F C5               [16]  355 	push	bc
                                    356 
                                    357 	; gbt_update has some "ret z" and things like that
                                    358 	; We call it from here to make it easier to mantain both
                                    359 	; RGBDS and GBDK versions.
    00000120 CD 25 01         [24]  360 	call	gbt_update
                                    361 
    00000123 C1               [12]  362 	pop	bc
                                    363 
    00000124 C9               [16]  364 	ret
                                    365 
                                    366 ;-------------------------------------------------------------------------------
                                    367 
    00000125                        368 gbt_update:
                                    369 
    00000125 FA 00 00         [16]  370 	ld	a,(gbt_playing)
    00000128 B7               [ 4]  371 	or	a,a
    00000129 C8               [20]  372 	ret	z ; If not playing, return
                                    373 
                                    374 	; Handle tick counter
                                    375 
    0000012A 21 12 00         [12]  376 	ld	hl,#gbt_ticks_elapsed
    0000012D FA 04 00         [16]  377 	ld	a,(gbt_speed) ; a = total ticks
    00000130 46               [ 8]  378 	ld	b,(hl) ; b = ticks elapsed
    00000131 04               [ 4]  379 	inc	b
    00000132 70               [ 8]  380 	ld	(hl),b
    00000133 B8               [ 4]  381 	cp	a,b
    00000134 28 09            [12]  382 	jr	z,.dontexit
                                    383 
                                    384 	; Tick != Speed, update effects and exit
    00000136 3E 01            [ 8]  385 	ld	a,#0x01
    00000138 EA 00 20         [16]  386 	ld	(#0x2000),a ; MBC1, MBC3, MBC5 - Set bank 1
    0000013B CD 00 00         [24]  387 	call	gbt_update_effects_bank1 ; Call update function in bank 1
                                    388 
    0000013E C9               [16]  389 	ret
                                    390 
    0000013F                        391 .dontexit:
    0000013F 36 00            [12]  392 	ld	(hl),#0x00 ; reset tick counter
                                    393 
                                    394 	; Clear tick-based effects
                                    395 	; ------------------------
                                    396 
    00000141 AF               [ 4]  397 	xor	a,a
    00000142 21 34 00         [12]  398 	ld	hl,#gbt_arpeggio_enabled ; Disable arpeggio
    00000145 22               [ 8]  399 	ld	(hl+),a
    00000146 22               [ 8]  400 	ld	(hl+),a
    00000147 77               [ 8]  401 	ld	(hl),a
    00000148 3D               [ 4]  402 	dec	a ; a = 0xFF
    00000149 21 3A 00         [12]  403 	ld	hl,#gbt_cut_note_tick ; Disable cut note
    0000014C 22               [ 8]  404 	ld	(hl+),a
    0000014D 22               [ 8]  405 	ld	(hl+),a
    0000014E 22               [ 8]  406 	ld	(hl+),a
    0000014F 77               [ 8]  407 	ld	(hl),a
                                    408 
                                    409 	; Update effects
                                    410 	; --------------
                                    411 
    00000150 3E 01            [ 8]  412 	ld	a,#0x01
    00000152 EA 00 20         [16]  413 	ld	(#0x2000),a ; MBC1, MBC3, MBC5 - Set bank 1
    00000155 CD 00 00         [24]  414 	call	gbt_update_effects_bank1 ; Call update function in bank 1
                                    415 
                                    416 	; Check if last step
                                    417 	; ------------------
                                    418 
    00000158 FA 3E 00         [16]  419 	ld	a,(gbt_have_to_stop_next_step)
    0000015B B7               [ 4]  420 	or	a,a
    0000015C 28 09            [12]  421 	jr	z,.dont_stop
                                    422 
    0000015E CD 0D 01         [24]  423 	call	_gbt_stop
    00000161 3E 00            [ 8]  424 	ld	a,#0
    00000163 EA 3E 00         [16]  425 	ld	(gbt_have_to_stop_next_step),a
    00000166 C9               [16]  426 	ret
                                    427 
    00000167                        428 .dont_stop:
                                    429 
                                    430 	; Get this step data
                                    431 	; ------------------
                                    432 
                                    433 	; Change to bank with song data
                                    434 
    00000167 FA 03 00         [16]  435 	ld	a,(gbt_bank)
    0000016A EA 00 20         [16]  436 	ld	(#0x2000),a ; MBC1, MBC3, MBC5
                                    437 
                                    438 	; Get step data
                                    439 
    0000016D FA 15 00         [16]  440 	ld	a,(gbt_current_step_data_ptr)
    00000170 6F               [ 4]  441 	ld	l,a
    00000171 FA 16 00         [16]  442 	ld	a,(gbt_current_step_data_ptr+1)
    00000174 67               [ 4]  443 	ld	h,a ; hl = pointer to data
                                    444 
    00000175 11 05 00         [12]  445 	ld	de,#gbt_temp_play_data
                                    446 
    00000178 06 04            [ 8]  447 	ld	b,#4
    0000017A                        448 .copy_loop:	; copy as bytes as needed for this step
                                    449 
    0000017A 2A               [ 8]  450 	ld	a,(hl+)
    0000017B 12               [ 8]  451 	ld	(de),a
    0000017C 13               [ 8]  452 	inc	de
    0000017D CB 7F            [ 8]  453 	bit	7,a
    0000017F 20 06            [12]  454 	jr	nz,.more_bytes
    00000181 CB 77            [ 8]  455 	bit	6,a
    00000183 28 0C            [12]  456 	jr	z,.no_more_bytes_this_channel
                                    457 
    00000185 18 07            [12]  458 	jr	.one_more_byte
                                    459 
    00000187                        460 .more_bytes:
                                    461 
    00000187 2A               [ 8]  462 	ld	a,(hl+)
    00000188 12               [ 8]  463 	ld	(de),a
    00000189 13               [ 8]  464 	inc	de
    0000018A CB 7F            [ 8]  465 	bit	7,a
    0000018C 28 03            [12]  466 	jr	z,.no_more_bytes_this_channel
                                    467 
    0000018E                        468 .one_more_byte:
                                    469 
    0000018E 2A               [ 8]  470 	ld	a,(hl+)
    0000018F 12               [ 8]  471 	ld	(de),a
    00000190 13               [ 8]  472 	inc	de
                                    473 
    00000191                        474 .no_more_bytes_this_channel:
    00000191 05               [ 4]  475 	dec	b
    00000192 20 E6            [12]  476 	jr	nz,.copy_loop
                                    477 
    00000194 7D               [ 4]  478 	ld	a,l
    00000195 EA 15 00         [16]  479 	ld	(gbt_current_step_data_ptr),a
    00000198 7C               [ 4]  480 	ld	a,h
    00000199 EA 16 00         [16]  481 	ld	(gbt_current_step_data_ptr+1),a ; save pointer to data
                                    482 
                                    483 	; Increment step/pattern
                                    484 	; ----------------------
                                    485 
