    000000F2                        300 _gbt_pause::
                                    301 	; GBDK-2020: single uint8_t arg in A
    000000F2 EA 00 00         [16]  302 	ld	(gbt_playing),a
    000000F5 B7               [ 4]  303 	or	a
    000000F6 20 04            [12]  304 	jr	nz,.gbt_pause_unmute
                                    305 
                                    306 	; Silence all channels
    000000F8 AF               [ 4]  307 	xor	a
    000000F9 E0 25            [12]  308 	ldh	(#.NR51),a
                                    309 
    000000FB C9               [16]  310 	ret
                                    311 
    000000FC                        312 .gbt_pause_unmute: ; Unmute sound if playback is resumed
                                    313 
                                    314     ; Restore panning status
    000000FC 21 18 00         [12]  315 	ld	hl,#gbt_pan
    000000FF 2A               [ 8]  316 	ld	a,(hl+)
    00000100 B6               [ 8]  317 	or	a,(hl)
    00000101 23               [ 8]  318 	inc	hl
    00000102 B6               [ 8]  319 	or	a,(hl)
    00000103 23               [ 8]  320 	inc hl
    00000104 B6               [ 8]  321 	or	a,(hl)
    00000105 EA 25 FF         [16]  322 	ld	(#.NR51),a
                                    323 
    00000108 C9               [16]  324 	ret
                                    325 
